# Docker Compose Postgres (default):
DATABASE_URL=postgres://wallet:wallet@127.0.0.1:5433/wallet_transfer?sslmode=disable

# Local Postgres example:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wallet_transfer?sslmode=disable

HTTP_ADDR=:8080
LOG_LEVEL=info
