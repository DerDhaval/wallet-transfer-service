    {
      "name": "04 — Business failures",
      "item": [
        {
          "name": "B1 Insufficient funds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('B1 status 422', function () { pm.response.to.have.status(422); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('failedTransferBody', pm.response.text());",
                  "pm.test('B1 INSUFFICIENT_FUNDS', function () {",
                  "  pm.expect(body.error.code).to.eql('INSUFFICIENT_FUNDS');",
                  "});",
                  "pm.test('B1 failed transfer recorded', function () {",
                  "  pm.expect(body.transfer).to.be.ok;",
                  "  pm.expect(body.transfer.status).to.eql('FAILED');",
                  "  pm.expect(body.transfer.failureReason).to.eql('INSUFFICIENT_FUNDS');",
                  "  pm.expect(body.transfer.amount).to.eql(999);",
                  "});"
                ]
              }
            }
          ],
          "request": {
